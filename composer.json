{
    "name": "migears/security",
    "description": "TinyGears Security - Security toolkit with TinyAuth classic implementation",
    "type": "library",
    "license": "MIT",
    "keywords": ["security", "auth", "password", "token", "csrf", "migears"],
    "require": {
        "php": "^8.1",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "MiGears\\Security\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MiGears\\Security\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
