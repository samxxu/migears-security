{
    "name": "migears/security",
    "description": "miGears Security - Security toolkit with MiAuth classic implementation",
    "type": "library",
    "license": "MIT",
    "version": "2.3.0",
    "keywords": [
        "security",
        "auth",
        "password",
        "token",
        "csrf",
        "migears"
    ],
    "homepage": "https://github.com/samxxu/migears-security",
    "authors": [
        {
            "name": "Sam X. Xu",
            "email": "samxxu@gmail.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/samxxu/migears-security/issues",
        "source": "https://github.com/samxxu/migears-security"
    },
    "require": {
        "php": "^8.1",
        "ext-openssl": "*",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "MiGears\\Security\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MiGears\\Security\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    }
}
