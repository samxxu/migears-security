{
    "name": "migears/security",
    "description": "miGears Security - Security toolkit with MiAuth classic implementation",
    "type": "library",
    "license": "MIT",
    "version": "2.0.0",
    "keywords": [
        "security",
        "auth",
        "password",
        "token",
        "csrf",
        "migears"
    ],
    "require": {
        "php": "^8.1",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "MiGears\\Security\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MiGears\\Security\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "scripts": {
        "test": "phpunit"
    }
}
